# Add your Claude API key here
# NEVER commit this file to version control!


CLAUDE_API_KEY='sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'

CHROMA_URL=http://localhost:8000

# PixelLab.ai API key for pixel art generation
PIXELLAB_API_KEY=''

# ElevenLabs API key for text-to-speech voice synthesis
ELEVENLABS_API_KEY=''

# How storyline NPCs decide at story hooks (scripts/storyline/):
#   offline - deterministic choice from SOUL.md want weights, no API calls (default)
#   claude  - ask Claude; falls back to offline on any error, timeout or missing key
NPC_AGENCY_MODE=offline

# Story clock: NPC decisions happen one per storyline per round. A round ends when a conversation
# ends, the player makes a choice or sets a flag, or changes scene; otherwise after this many
# seconds of unpaused play
STORY_ROUND_SECONDS=300
