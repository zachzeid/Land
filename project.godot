; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Land"
config/description="AI-driven open-world JRPG where player choices shape the world"
config/version="0.1.0"
run/main_scene="uid://dwvjq7m8xnh2p"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

WorldRegistry="*res://scripts/world/world_registry.gd"
EventBus="*res://scripts/world_state/event_bus.gd"
WorldState="*res://scripts/world_state/world_state.gd"
WorldKnowledge="*res://scripts/world_state/world_knowledge.gd"
WorldEvents="*res://scripts/world_state/world_events.gd"
DialogueManager="*res://scripts/dialogue/dialogue_manager.gd"
Config="*res://scripts/core/config.gd"
AssetGenerator="*res://scripts/generation/asset_generator_manager.gd"
SceneManager="*res://scripts/world/scene_manager.gd"
AssetPreloader="*res://scripts/loading/asset_preloader.gd"
SceneAnalyzer="*res://scripts/generation/scene_analyzer.gd"
CharacterGen="*res://scripts/generation/character_generator.gd"
InteractionDebug="*res://scripts/debug/interaction_debug_overlay.gd"
DynamicNPCRegistry="*res://scripts/world_state/dynamic_npc_registry.gd"
DynamicNPCGen="*res://scripts/generation/dynamic_npc_generator.gd"
VoiceManager="*res://scripts/audio/voice_manager.gd"
QuestManager="*res://scripts/quests/quest_manager.gd"
SampleQuests="*res://scripts/quests/sample_quests.gd"
EventPropagator="*res://scripts/world_state/event_propagator.gd"
StorylineDirector="*res://scripts/storyline/storyline_director.gd"
TravelMap="*res://scripts/world/travel_map.gd"
PlayerEvents="*res://scripts/world_state/player_events.gd"
InnerVoice="*res://scripts/storyline/inner_voice.gd"
PlayerStats="*res://scripts/player/player_stats.gd"
Inventory="*res://scripts/player/inventory.gd"
Crafting="*res://scripts/crafting/crafting.gd"
Combat="*res://scripts/combat/combat.gd"
WorldPhysics="*res://scripts/world/physics/world_physics.gd"
Puzzles="*res://scripts/puzzles/puzzles.gd"
Taverns="*res://scripts/world/taverns.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

