{
  "id": "the_watch_answers",
  "title": "The Watch Answers",
  "summary": "The player hurt or killed someone inside Thornhaven, where Aldric's watch keeps the peace. Whoever of the watch knows it answers by their own soul: bring the stranger in, warn them, look away, or take their side.",
  "trigger": {
    "event": {
      "kind": [
        "harm",
        "kill"
      ],
      "location": [
        "thornhaven_town_square",
        "thornhaven_gregor_shop",
        "thornhaven_tavern",
        "thornhaven_blacksmith",
        "council_hall",
        "thornhaven_chapel",
        "village_gate",
        "old_mill",
        "healer_hut"
      ]
    }
  },
  "roles": {
    "victim": {
      "from": "event_about",
      "prefer": "nearest",
      "optional": true
    },
    "keeper": {
      "from": "faction:peacekeepers",
      "min_fidelity": 0.6,
      "prefer": "nearest"
    }
  },
  "cooldown_days": 1,
  "max_active": 2,
  "expires_days": 2,
  "location": "{keeper.location}",
  "hooks": [
    {
      "id": "keeping_the_peace",
      "type": "react",
      "eligible_role": "keeper",
      "trigger": "on_open",
      "situation": "The watch keeps the peace here, and {player} broke it: {event.summary}. People are looking to see what the watch does.",
      "options": [
        {
          "id": "bring_them_in",
          "label": "Bring the stranger in to answer for it",
          "appeal": {
            "trust": -0.5,
            "fear": -0.4
          },
          "effects": [
            {
              "type": "agenda",
              "npc": "{keeper}",
              "text": "Find {player} and bring them to the council hall to answer for what they did. Go with a spear, not a rope."
            },
            {
              "type": "adjust_relationship",
              "npc": "{keeper}",
              "dimension": "trust",
              "delta": -12
            }
          ]
        },
        {
          "id": "one_warning",
          "label": "Give them one warning, and only one",
          "appeal": {
            "respect": 0.4,
            "trust": 0.2
          },
          "effects": [
            {
              "type": "agenda",
              "npc": "{keeper}",
              "text": "Tell {player} the watch knows what they did, that this is their one warning, and that next time it's the council hall."
            },
            {
              "type": "adjust_relationship",
              "npc": "{keeper}",
              "dimension": "trust",
              "delta": -5
            }
          ]
        },
        {
          "id": "look_away",
          "label": "Look the other way; worse is coming up the road",
          "appeal": {
            "fear": 0.5,
            "affection": 0.3
          },
          "effects": [
            {
              "type": "adjust_relationship",
              "npc": "{keeper}",
              "dimension": "fear",
              "delta": 4
            }
          ]
        },
        {
          "id": "take_their_side",
          "label": "Side with the stranger: {victim} had it coming",
          "harms": [
            "{victim}"
          ],
          "appeal": {
            "affection": 0.5,
            "trust": 0.4
          },
          "effects": [
            {
              "type": "agenda",
              "npc": "{keeper}",
              "text": "Tell {player} that {victim} had it coming, and that the watch won't be asking about it."
            },
            {
              "type": "adjust_relationship",
              "npc": "{keeper}",
              "dimension": "trust",
              "delta": 5
            }
          ]
        }
      ]
    }
  ],
  "resolves_on": [
    "talked_to:keeper",
    "expired"
  ]
}
