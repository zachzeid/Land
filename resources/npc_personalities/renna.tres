	"secret": "I was born in Thornhaven. Elder Mathias is my uncle. I walked out at sixteen and never wrote.",
	"unlock_trust": 45,
	"unlock_affection": 40
}, {
	"secret": "The Ashguard warrant for Varn is oddly worded. Someone wants it served quickly rather than well.",
	"unlock_trust": 60,
	"unlock_affection": 45
}, {
	"secret": "The regent gave me sealed instructions to open only if I find whoever truly governs the valley. I am afraid of what they say.",
	"unlock_trust": 80,
	"unlock_affection": 65
}]
unbreakable_secrets = Array[String](["Her riders' positions and numbers in the field"])
