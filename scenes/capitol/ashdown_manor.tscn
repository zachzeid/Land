horizontal_alignment = 1

[node name="TurnedPortrait" type="Area2D" parent="Details"]
z_index = 6
position = Vector2(0, -400)
collision_layer = 16
collision_mask = 1
script = ExtResource("5_story_item")
interaction_name = "Examine the Portrait"
flag_to_set = ""
discovery_text = "[b]The last portrait[/b]

The others were sold; their pale squares still mark the silk. This one remains, but it hangs with its face to the wall.

On the back, a brass plate: \"[i]Aldous, Lord Ashdown, who fed Highmarch in the Grey Year.[/i]\" Someone has written under it in pencil, in a woman's small hand: [i]and was paid for every loaf.[/i]"
reexamine_text = "Lord Aldous fed the city in the Grey Year, and was paid for every loaf."

