[node name="HerbNotes" type="Area2D" parent="Details"]
z_index = 6
position = Vector2(650, -566)
collision_layer = 16
collision_mask = 1
script = ExtResource("4_story_item")
interaction_name = "Read the Herb Notes"
flag_to_set = ""
discovery_text = "[b]Sister Ysolde's notes[/b]

Pressed fever-root, a mortar still green at the rim, and pages of small, impatient writing:
\"[i]Root alone eases the sweats and nothing more. The old cure needs the salt, and the salt comes only from the deep vein at Greystone. Brackenmoor kept the receipt from the Grey Year. Write to Brother Anselm again. Do not send it through the Prelate's clerk.[/i]\""
reexamine_text = "The salt comes only from the deep vein at Greystone."

