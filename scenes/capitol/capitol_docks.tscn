[node name="CustomsNotice" type="Area2D" parent="Details"]
z_index = 6
position = Vector2(40, -210)
collision_layer = 16
collision_mask = 1
script = ExtResource("9_story_item")
interaction_name = "Read the Customs Notice"
flag_to_set = ""
discovery_text = "[b]Riverside customs[/b]

Nailed to a post at the quay's edge, in the Guild's hand and the crown's seal:
\"[i]Barges and wagons under the seal of the Merchants' Guild are bonded, and shall not be opened by any reeve, toll-man or officer of the river.[/i]\"

Beneath it a drowned rat has been nailed through the tail. A dockhand's joke, or a warning."
reexamine_text = "Guild-sealed cargo shall not be opened."

