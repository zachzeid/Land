theme_override_font_sizes/font_size = 14
text = "[E] Read the Debt Book"
horizontal_alignment = 1

[node name="DraftLetter" type="Area2D" parent="Details"]
z_index = 6
position = Vector2(260, -200)
collision_layer = 16
collision_mask = 1
script = ExtResource("7_story_item")
interaction_name = "Read the Draft"
flag_to_set = ""
discovery_text = "[b]A letter in draft[/b]

\"[i]To his Grace the Lord Protector. The Guild has carried the crown's purse through four lean years and asks nothing for it but the chance to carry it further. A seat at the regency council table would allow the Guild to... [/i]\"

The sentence has been begun six times and crossed out five."
reexamine_text = "Hollis wants a seat at the regency table."

