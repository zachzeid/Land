horizontal_alignment = 1

[node name="RangerDispatch" type="Area2D" parent="Details"]
z_index = 6
position = Vector2(520, 476)
collision_layer = 16
collision_mask = 1
script = ExtResource("5_story_item")
interaction_name = "Read the Dispatch"
flag_to_set = ""
discovery_text = "[b]A dispatch awaiting the seal[/b]

\"[i]To Captain Renna Thorne of the King's Rangers. You will ride west with forty and restore the King's peace in the Western Valley. You will bring back the tithe, or the men who took it. If neither can be found, you will bring back someone the court can be shown.[/i]\"

The wax is warm in the dish. It has not yet been signed."
reexamine_text = "Bring back the tithe, or someone the court can be shown."

