horizontal_alignment = 1

[node name="ChalkedDoor" type="Area2D" parent="Details"]
z_index = 6
position = Vector2(-170, 252)
collision_layer = 16
collision_mask = 1
script = ExtResource("6_story_item")
interaction_name = "Look at the Chalked Door"
flag_to_set = ""
discovery_text = "[b]A door marked in grey chalk[/b]

A cross in grey chalk, the old sign from the fever year: [i]sickness in this house, keep away[/i]. The chalk is new. Inside, somebody coughs and does not stop.

Somebody else has written beneath the cross, smaller: \"[i]The Cathedral says it's marsh chill. The Cathedral says five silver.[/i]\""
reexamine_text = "A fresh grey cross. The fever is back in the Warrens."

