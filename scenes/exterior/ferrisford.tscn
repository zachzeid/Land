[node name="CargoBales" type="Area2D" parent="StoryItems"]
z_index = 6
position = Vector2(60, 70)
script = ExtResource("2_story_item")
interaction_name = "Look at the waiting bales"
flag_to_set = "ferrisford_unmarked_cargo_seen"
discovery_text = "[b]Bales on the quay[/b]

Bales wait for the next barge east: good wool and crated ironwork, wrapped in sacking with no guild seal and no tithe stamp. The only mark is a twist of iron wire round every knot.

The bargemen do not look at them, or at you."
reexamine_text = "Iron wire round every knot, and no tithe stamp anywhere."

