[node name="Interactables" type="Node2D" parent="."]
z_index = 6

[node name="MillSign" type="Area2D" parent="Interactables"]
z_index = 6
position = Vector2(-160, -270)
collision_layer = 16
collision_mask = 1
script = ExtResource("10_story_item")
interaction_name = "Read the Old Sign"
flag_to_set = ""
discovery_text = "[b]The mill sign[/b]

'THORNHAVEN MILL. Ground for the valley since the old king's day. Honest weight.'

Nailed over it, a board in a different hand, weathered grey: 'Closed. The Hollow burned the grain store the first winter and took the miller's horse. I have gone east to my sister. Do not wait for me. - Hale the miller.'"
reexamine_text = "The miller went east after the Hollow's first winter. Nobody has ground here since."

