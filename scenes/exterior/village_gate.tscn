[node name="DutyRoster" type="Area2D" parent="Interactables"]
z_index = 6
position = Vector2(170, -215)
collision_layer = 16
collision_mask = 1
script = ExtResource("16_story_item")
interaction_name = "Read the Duty Roster"
flag_to_set = ""
discovery_text = "[b]The peacekeepers' roster[/b]

Eight names in Aldric's square hand. Three are struck through: 'gone to his brother's farm', 'hurt, will not return', and one with no reason given.

The night-watch column runs down the page: 'Aldric. Aldric. Aldric. Aldric.'"
reexamine_text = "Five peacekeepers left of eight. The night watch is always Aldric."

