[node name="CouncilNotice" type="Area2D" parent="Interactables"]
z_index = 6
position = Vector2(80, -60)
collision_layer = 16
collision_mask = 1
script = ExtResource("16_story_item")
interaction_name = "Read the Notice"
flag_to_set = ""
discovery_text = "[b]A notice on the gatepost[/b]

'BY ORDER OF THE ELDERS. Travellers on the forest road go at their own peril. The council of Thornhaven does not treat with brigands, and pays no ransoms.'

Someone has carved beneath it, small and deep: 'pays them anyway.'"
reexamine_text = "'The council pays no ransoms.' Under it: 'pays them anyway.'"

