[node name="CaptainsPetition" type="Area2D" parent="Interactables"]
z_index = 6
position = Vector2(110, -245)
collision_layer = 16
collision_mask = 1
script = ExtResource("7_story_item")
interaction_name = "Read the Petition"
flag_to_set = ""
discovery_text = "[b]A petition, nailed and then taken down[/b]

'To the elders of Thornhaven. The undersigned peacekeepers ask leave to bear the smith's steel in the village's defence, and that the coin paid to the forest be spent instead on spears. - Aldric, Captain of the Watch.'

Six names below his, three of them only marks. Across the top, in another hand: 'Deferred. Again.'"
reexamine_text = "'Deferred. Again.' Aldric's six volunteers are still waiting for an answer."

