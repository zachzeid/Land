[node name="PriceSlate" type="Area2D" parent="Interactables"]
z_index = 6
position = Vector2(-80, -205)
collision_layer = 16
collision_mask = 1
script = ExtResource("5_story_item")
interaction_name = "Read the Slate"
flag_to_set = ""
discovery_text = "[b]A slate by the door[/b]

'Setting a bone - 5 silver.
A birthing - 7 silver, or a pig.
A knife wound, no questions - 12 silver.
A fever of the grey kind - ONE GOLD. Paid before. I do not work for promises.'

Below, a list of debts long rubbed out, and one fresh: 'G., the merchant. Asked the price. Did not pay.'

And a tally with no name and no price, a stroke for every day since midsummer: 'Dressings. Two fingers gone, left hand. Wash the white dust out of the cuts, every morning, it will not stop coming.'"
reexamine_text = "A gold for the grey fever. And a nameless tally: two fingers gone, white dust in the cuts."

