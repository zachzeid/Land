[node name="SleepingStraw" type="Area2D" parent="StoryItems"]
z_index = 6
position = Vector2(-290, 250)
collision_layer = 16
collision_mask = 1
script = ExtResource("3_story_item")
interaction_name = "Look at the straw"
flag_to_set = ""
discovery_text = "[b]Where they sleep[/b]

Straw pallets in a row, too few blankets. Under one, a little wooden fox carved with something blunt, its ears worn smooth by a thumb. Under another, a pebble scratched with a hammer over a pine tree, the way a smith's boy might copy his master's mark."
reexamine_text = "A carved fox, and a pebble scratched with Bjorn's hammer and pine."

