{"templates": [
  {"id": "fx_broken_promise", "title": "The Promise You Didn't Keep", "summary": "Someone you failed remembers.",
   "trigger": {"event": {"kind": "promise", "status": "broken"}},
   "roles": {"wronged": {"from": "event_witness", "prefer": "affection_desc"}},
   "cooldown_days": 1, "max_active": 1, "expires_days": 2,
   "location": "{wronged.home}",
   "hooks": [{"id": "confront", "type": "react", "eligible_role": "wronged", "trigger": "on_open",
     "situation": "{player} swore to {event.summary}. They didn't.",
     "options": [
       {"id": "demand", "label": "Find them and demand an answer", "appeal": {"trust": -0.5, "fear": -0.3, "respect": 0.2},
        "effects": [{"type": "agenda", "npc": "{wronged}", "text": "Ask {player} why their word was worth nothing ({event.id})."},
                    {"type": "adjust_relationship", "npc": "{wronged}", "dimension": "trust", "delta": -10}]},
       {"id": "tell_others", "label": "Make sure the village knows", "appeal": {"affection": -0.5},
        "effects": [{"type": "spread_event", "event": "{event.id}", "to": ["*"]}]},
       {"id": "let_it_go", "label": "Say nothing; remember it", "appeal": {"affection": 0.6}, "effects": []}]}],
   "resolves_on": ["talked_to:wronged", "expired"]},
  {"id": "fx_gift_gossip", "title": "A Gift Talked About", "summary": "A gift gets talked about.",
   "trigger": {"event": {"kind": "gift", "tone": "warm"}},
   "roles": {"gossip": {"from": "near_player", "prefer": "familiarity_desc"}},
   "cooldown_days": 0, "max_active": 3, "expires_days": 3,
   "hooks": [{"id": "talk", "type": "react", "eligible_role": "gossip", "trigger": "on_open",
     "situation": "{player} gave a gift: {event.summary}.",
     "options": [
       {"id": "move_the_cart", "label": "Ask for the cart to come late", "appeal": {"familiarity": 5.0},
        "effects": [{"type": "shift_fixed_point", "point": "tn_collection_night", "days": 1, "reason": "A gossip asked for the cart to come late."}]},
       {"id": "tell_round", "label": "Tell everyone", "appeal": {"familiarity": 1.0},
        "effects": [{"type": "spread_event", "event": "{event.id}", "to": ["{gossip}", "*"]},
                    {"type": "agenda", "npc": "aldric", "text": "Mention that {gossip.name} talks of the stranger's gift."}]},
       {"id": "keep_quiet", "label": "Keep it quiet", "appeal": {"familiarity": 0.1}, "effects": []}]}],
   "resolves_on": ["days:1"]},
  {"id": "fx_cold_village", "title": "The Village Turns Cold", "summary": "The elder asks the Hollow for time.",
   "trigger": {"reputation": {"faction": "thornhaven", "below": -40}, "flag": "!tn_collection_night"},
   "roles": {"elder": {"from": "npc:mathias"}},
   "cooldown_days": 30, "max_active": 1, "expires_days": 5,
   "hooks": [{"id": "beg", "type": "aid", "eligible_role": "elder", "trigger": "on_open",
     "situation": "The village has turned on {player}.",
     "options": [
       {"id": "beg_a_day", "label": "Beg the Hollow for a day", "appeal": {"trust": 0.5},
        "effects": [{"type": "shift_fixed_point", "point": "tn_collection_night", "days": 1, "reason": "The elder begged the Hollow for one more day."}]},
       {"id": "do_nothing", "label": "Do nothing", "appeal": {"trust": -0.5}, "effects": []}]}],
   "resolves_on": ["fx_story_done", "expired"]},
  {"id": "fx_feared", "title": "Someone Afraid", "summary": "Someone who fears the stranger.",
   "trigger": {"relationship": {"npc": "any", "dimension": "fear", "above": 50}},
   "roles": {"afraid": {"from": "trigger_match"}},
   "cooldown_days": 1, "max_active": 1, "expires_days": 1,
   "hooks": [{"id": "flinch", "type": "react", "eligible_role": "afraid", "trigger": "on_open",
     "situation": "{player} frightens you.",
     "options": [{"id": "avoid", "label": "Keep away", "appeal": {"fear": 1.0},
        "effects": [{"type": "agenda", "npc": "{afraid}", "text": "Keep the talk short with {player}."}]}]}],
   "resolves_on": ["expired"]}
]}
